# DEMO VALUES ONLY - public in this repo, never use them for a real deployment.
# Generate real ones with:  python -m bulb_bridge.cli new-secret / hash <secret>
#
# Demo credentials (plaintext, for trying the API):
#   API key (read + events):  demo-read-key-0123456789
#   API key (read + write):   demo-ops-key-0123456789
#   OAuth client:             shop-backend / demo-client-secret-0123456789
#   Shop webhook secret:      demo-shop-secret-0123456789
#   Subscriber secret:        demo-subscriber-secret-0123

MQTT_HOST=mosquitto
BRIDGE_JWT_SECRET=demo-jwt-secret-change-me-0123456789abcdef
BRIDGE_SHOP_WEBHOOK_SECRETS=demo-shop-secret-0123456789
BRIDGE_API_KEYS=[{"name":"dashboard","sha256":"22fa51f876b88f5ac2917d7c42590c348cb42c06a63591753bd7070219cf4e45","scopes":["devices:read","events:read"]},{"name":"ops","sha256":"dc8b69b9282676976b4b35742b6197fa0f34ad6eb56832b4ec55799a1eef39f2","scopes":["devices:read","devices:write"]}]
BRIDGE_OAUTH_CLIENTS=[{"client_id":"shop-backend","secret_sha256":"efbee28d878147551c80f29e7f0de8971f00ae703a3edb8f64f03e95241a64c8","scopes":["devices:read","devices:write","events:read"]}]
BRIDGE_RULES=[{"event":"order.paid","device":"sim-rgbcct","command":{"color":{"r":0,"g":255,"b":0},"brightness":255,"effect":"pulse"},"duration_s":4},{"event":"order.refunded","device":"sim-rgbw","command":{"color":{"r":255,"g":0,"b":0},"effect":"pulse"},"duration_s":4}]
BRIDGE_WEBHOOK_SUBSCRIBERS=[{"url":"http://webhook-receiver:9000/","secret":"demo-subscriber-secret-0123","events":["device.state","device.availability"]}]
